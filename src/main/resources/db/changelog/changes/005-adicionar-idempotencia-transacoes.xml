<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="008-adicionar-idempotencia-transacoes" author="jeferson">
        <addColumn tableName="transacoes">
            <column name="idempotency_key" type="VARCHAR(100)"/>
        </addColumn>
        <addUniqueConstraint tableName="transacoes" columnNames="idempotency_key"
                             constraintName="uk_transacoes_idempotency_key"/>
    </changeSet>
</databaseChangeLog>
