<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="010-adicionar-usuarios-autenticacao" author="jeferson">
        <createTable tableName="usuarios">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_usuarios" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(254)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_usuarios_email"/>
            </column>
            <column name="senha_hash" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="perfil" type="VARCHAR(30)" defaultValue="USER">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="data_hora_cadastro" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
