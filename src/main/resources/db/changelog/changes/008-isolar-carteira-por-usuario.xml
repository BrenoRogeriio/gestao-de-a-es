<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="011-isolar-carteira-por-usuario" author="jeferson">
        <!-- Nullable intencionalmente: o proprietário dos registros legados é desconhecido. -->
        <addColumn tableName="posicoes">
            <column name="usuario_id" type="BIGINT"/>
        </addColumn>
        <addColumn tableName="transacoes">
            <column name="usuario_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="posicoes" baseColumnNames="usuario_id"
                                 referencedTableName="usuarios" referencedColumnNames="id"
                                 constraintName="fk_posicao_usuario"/>
        <addForeignKeyConstraint baseTableName="transacoes" baseColumnNames="usuario_id"
                                 referencedTableName="usuarios" referencedColumnNames="id"
                                 constraintName="fk_transacao_usuario"/>

        <dropUniqueConstraint tableName="posicoes" constraintName="uk_posicoes_acao"/>
        <addUniqueConstraint tableName="posicoes" columnNames="usuario_id, acao_id"
                             constraintName="uk_posicoes_usuario_acao"/>

        <dropUniqueConstraint tableName="transacoes" constraintName="uk_transacoes_idempotency_key"/>
        <addUniqueConstraint tableName="transacoes" columnNames="usuario_id, idempotency_key"
                             constraintName="uk_transacoes_usuario_idempotency_key"/>

        <createIndex tableName="transacoes" indexName="idx_transacoes_usuario_data">
            <column name="usuario_id"/>
            <column name="data_hora_transacao"/>
        </createIndex>
        <createIndex tableName="transacoes" indexName="idx_transacoes_usuario_tipo">
            <column name="usuario_id"/>
            <column name="tipo_transacao"/>
        </createIndex>
    </changeSet>

    <!-- H2 preserva o índice implícito da constraint inline mesmo após removê-la. -->
    <changeSet id="012-remover-indice-global-posicoes-h2" author="jeferson" dbms="h2">
        <dropForeignKeyConstraint baseTableName="posicoes" constraintName="fk_posicao_acao"/>
        <addForeignKeyConstraint baseTableName="posicoes" baseColumnNames="acao_id"
                                 referencedTableName="acoes" referencedColumnNames="id"
                                 constraintName="fk_posicao_acao"/>
    </changeSet>
</databaseChangeLog>
